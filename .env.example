# Environment configuration for AO-03

# Application
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=dev-secret-key-change-in-production

# Storage Backend: "sqlite" (default local zero-setup) or "supabase"
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=data/ao03_telemetry.db

# Supabase Configuration (Optional - only required if STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Ollama Local LLM Provider (no API key required — runs on localhost)
# System falls back gracefully to Heuristic / Offline explanation if Ollama is unavailable
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
